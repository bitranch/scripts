{
	"extends": "./src/tsconfig/commonjs.json",
	"compilerOptions": {
		"declaration": false,
		"downlevelIteration": false,
		"ignoreDeprecations": "6.0",
		"importHelpers": false,
		"outDir": "dist/cjs",
		"skipLibCheck": true,
		"target": "es5"
	},
	"include": [
		"./src/**/*.ts",
		"./tests/**/*.ts"
	]
}
